{
  "name": "lablink",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "vite --config client/vite.config.ts",
    "dev:server": "node --watch --env-file-if-exists=.env server/index.mjs",
    "check": "tsc --noEmit && node --check server/index.mjs",
    "test": "node --test",
    "build": "npm run check && vite build --config client/vite.config.ts",
    "start": "node --env-file-if-exists=.env server/index.mjs"
  },
  "dependencies": {
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.9.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vite": "^6.4.0"
  }
}
